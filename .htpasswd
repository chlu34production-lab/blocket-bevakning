# Kör detta i terminalen för att generera din .htpasswd-fil
# Byt ut "mittlösenord" mot ditt eget lösenord

htpasswd -c .htpasswd admin

# Du blir ombedd att ange lösenord två gånger.
# Filen .htpasswd skapas i samma mapp du kör kommandot.

# ── Har du inte htpasswd installerat? ─────────────────────
# macOS: redan installerat
# Windows: ladda ner Apache från https://www.apachelounge.com
# Eller generera online på: https://www.htaccesstools.com/htpasswd-generator/
